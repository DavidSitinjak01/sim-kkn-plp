# ============================================================
# SIM KKN & PLP — Environment Variables
# ============================================================
# Copy this file to `.env` for local development, or set these
# as Environment Variables in your Vercel project settings.
# ============================================================

# --- Database (REQUIRED) ---
# PostgreSQL connection string.
# Recommended providers for Vercel: Neon (https://neon.tech),
# Supabase (https://supabase.com), or Vercel Postgres.
#
# Local dev:  postgresql://user:password@localhost:5432/sim_kkn_plp
# Neon:       postgresql://user:password@ep-xxx.region.aws.neon.tech/sim_kkn_plp?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/sim_kkn_plp"

# --- WhatsApp Gateway (OPTIONAL) ---
# If empty, WhatsApp notifications run in simulation mode
# (messages are logged to the server console instead of sent).
# Compatible with Fonnte (https://fonnte.com).
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_API_KEY=""
WA_SENDER=""
