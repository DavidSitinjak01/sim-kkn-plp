# ============================================================
# SIM KKN & PLP — Environment Variables
# ============================================================
# Copy this file to `.env` for local development, or set these
# as Environment Variables in your Vercel project settings
# (https://vercel.com/<org>/<project>/settings/environment-variables).
# ============================================================

# --- Database (REQUIRED) ---
# Vercel's serverless filesystem is ephemeral, so SQLite (file:./...) will
# NOT persist data across cold starts. For production you MUST use a managed
# PostgreSQL. Recommended free providers:
#
#   Neon        https://neon.tech          (best for Vercel, serverless PG)
#   Supabase    https://supabase.com
#   Vercel Postgres  https://vercel.com/docs/storage/vercel-postgres
#
# After creating the database, copy its connection string here.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Example (Neon):
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/sim_kkn_plp?sslmode=require"

# --- Local dev fallback (SQLite) ---
# If you prefer SQLite for local dev, comment out the line above and
# uncomment this one. Note: the Prisma schema provider is set to
# "postgresql" for Vercel; for local sqlite dev you must temporarily
# change it in prisma/schema.prisma to provider = "sqlite".
# DATABASE_URL="file:./dev.db"

# --- WhatsApp Gateway (OPTIONAL) ---
# If empty, WhatsApp notifications run in simulation mode
# (messages are logged to the server console instead of sent).
# Compatible with Fonnte (https://fonnte.com).
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_API_KEY=""
WA_SENDER=""

# --- NextAuth (OPTIONAL, reserved for future use) ---
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL=""
