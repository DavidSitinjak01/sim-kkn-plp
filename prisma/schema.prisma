// Sistem Informasi Manajemen KKN & PLP Universitas
// Database schema normalized to 3NF

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // IMPORTANT: this app supports BOTH sqlite (local dev) and postgresql (Vercel).
  // - Local dev:  set DATABASE_URL="file:./dev.db" in .env (Prisma will auto-detect
  //   that the URL starts with "file:" and use the sqlite provider).
  // - Vercel:     set DATABASE_URL to a postgresql:// connection string from Neon,
  //   Supabase, or Vercel Postgres in the Vercel project settings.
  //
  // We default to postgresql because Vercel's serverless filesystem is ephemeral
  // (SQLite files would be lost on every cold start). For local dev you can either
  // keep using sqlite by setting the provider to "sqlite" here, or run a local
  // postgres (e.g. via docker) and point DATABASE_URL at it.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ MASTER AKADEMIK ============

model Fakultas {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  dekan     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prodi     ProgramStudi[]
  dosen     Dosen[]
}

model ProgramStudi {
  id         String   @id @default(cuid())
  kode       String   @unique
  nama       String
  jenjang    String   // S1, S2, S3, D3, D4
  fakultasId String
  fakultas   Fakultas @relation(fields: [fakultasId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mahasiswa  Mahasiswa[]
  dosen      Dosen[]
  pendaftaran Pendaftaran[]
}

// ============ AUTENTIKASI & USER ============

model User {
  id        String   @id @default(cuid())
  username  String?  @unique // login credential (plain name, NOT email format); optional in schema to allow migration on populated DBs, but enforced required at app layer. Backfilled by scripts/backfill-username.ts during build.
  email     String?  @unique // optional contact email (NOT used for login); unique when set
  password  String
  name      String
  role      String   // SUPER_ADMIN, ADMIN_FAKULTAS, ADMIN_PRODI, DOSEN, MAHASISWA, PIMPINAN
  avatar    String?
  status    String   @default("AKTIF") // AKTIF, NONAKTIF
  phone     String?
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mahasiswa Mahasiswa?
  dosen     Dosen?
  aktivitas Aktivitas[]
}

// ============ DATA MAHASISWA ============

model Mahasiswa {
  id            String        @id @default(cuid())
  nim           String        @unique
  nama          String
  jenisKelamin  String        // L, P
  tempatLahir   String
  tanggalLahir  DateTime
  alamat        String
  noHp          String
  email         String
  prodiId       String
  prodi         ProgramStudi  @relation(fields: [prodiId], references: [id])
  semester      Int
  angkatan      Int
  status        String        @default("AKTIF") // AKTIF, LULUS, CUTI, DO
  foto          String?
  userId        String?       @unique
  user          User?         @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  kelompokMember KelompokMember[]
  absensi       Absensi[]
  penilaian     Penilaian[]
}

// ============ DATA DOSEN ============

model Dosen {
  id         String        @id @default(cuid())
  nidn       String        @unique
  nama       String
  email      String
  noHp       String
  fakultasId String
  fakultas   Fakultas      @relation(fields: [fakultasId], references: [id])
  prodiId    String?
  prodi      ProgramStudi? @relation(fields: [prodiId], references: [id])
  jabatan    String
  keahlian   String?
  foto       String?
  status     String        @default("AKTIF")
  userId     String?       @unique
  user       User?         @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  kelompok   Kelompok[]
  penilaian  Penilaian[]
}

// ============ LOKASI KKN & PLP ============

model Desa {
  id         String     @id @default(cuid())
  nama       String
  kecamatan  String
  kabupaten  String
  provinsi   String
  kodePos    String?
  latitude   Float?
  longitude  Float?
  kuota      Int        @default(0)
  keterangan String?
  foto       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  kelompok   Kelompok[]
}

model Sekolah {
  id            String   @id @default(cuid())
  nama          String
  jenjang       String   // SD, SMP, SMA, SMK
  alamat        String
  kecamatan     String
  kabupaten     String
  provinsi      String
  kepalaSekolah String
  noHp          String
  email         String?
  latitude      Float?
  longitude     Float?
  kuota         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  kelompok      Kelompok[]
}

// ============ PEMBAGIAN KKN & PLP ============

model Kelompok {
  id            String   @id @default(cuid())
  nama          String
  tipe          String   // KKN, PLP1, PLP2
  tahunAkademik String
  semester      String   // GANJIL, GENAP
  desaId        String?
  desa          Desa?    @relation(fields: [desaId], references: [id])
  sekolahId     String?
  sekolah       Sekolah? @relation(fields: [sekolahId], references: [id])
  dosenId       String?
  dosen         Dosen?   @relation(fields: [dosenId], references: [id])
  status        String   @default("AKTIF")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       KelompokMember[]
  absensi       Absensi[]
  penilaian     Penilaian[]
}

model KelompokMember {
  id          String    @id @default(cuid())
  kelompokId  String
  kelompok    Kelompok  @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  mahasiswaId String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([kelompokId, mahasiswaId])
}

// ============ ABSENSI ============

model Absensi {
  id           String    @id @default(cuid())
  mahasiswaId  String
  mahasiswa    Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  kelompokId   String
  kelompok     Kelompok  @relation(fields: [kelompokId], references: [id])
  tanggal      DateTime
  jamMasuk     DateTime?
  jamPulang    DateTime?
  latitude     Float?
  longitude    Float?
  fotoSelfie   String?
  status       String    // HADIR, IZIN, SAKIT, ALPHA
  keterangan   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============ PERSURATAN ============

model Surat {
  id       String   @id @default(cuid())
  nomor    String
  jenis    String   // TUGAS, PENGANTAR, IZIN, PENEMPATAN, BALASAN, SELESAI
  perihal  String
  tanggal  DateTime @default(now())
  pemohon  String
  tujuan   String
  status   String   @default("DRAFT") // DRAFT, DIKIRIM, SELESAI
  konten   String
  filePdf  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PENILAIAN ============

model Penilaian {
  id          String    @id @default(cuid())
  mahasiswaId String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  kelompokId  String
  kelompok    Kelompok  @relation(fields: [kelompokId], references: [id])
  dosenId     String?
  dosen       Dosen?    @relation(fields: [dosenId], references: [id])
  jenis       String    // KKN, PLP1, PLP2
  aspek       String
  nilai       Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============ INFORMASI ============

model Pengumuman {
  id        String   @id @default(cuid())
  judul     String
  konten    String
  prioritas String   @default("NORMAL") // URGENT, NORMAL, INFO
  tanggal   DateTime @default(now())
  penulis   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agenda {
  id        String   @id @default(cuid())
  judul     String
  tanggal   DateTime
  lokasi    String?
  deskripsi String?
  tipe      String   @default("UMUM") // KKN, PLP, UMUM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ AUDIT ============

model Aktivitas {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  aksi      String
  modul     String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ============ PENGATURAN ============

model Pengaturan {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ PENDAFTARAN PESERTA KKN/PLP (PUBLIC FORM) ============
// Diisi oleh calon peserta melalui link publik (/?daftar=true).
// Admin dapat menyetujui/menolak dan mengimpor ke tabel Mahasiswa.

model Pendaftaran {
  id            String   @id @default(cuid())
  namaLengkap   String
  nim           String   @unique
  prodiId       String?  // relasi opsional ke ProgramStudi (jika prodi ada di sistem)
  prodi         ProgramStudi? @relation(fields: [prodiId], references: [id])
  prodiNama     String   // nama prodi bebas (dipilih dari dropdown atau diketik)
  jurusan       String   // jurusan / fakultas (bebas teks)
  jenisKelamin  String   // L, P
  noWa          String
  punyaMotor    Boolean
  alamat        String
  foto          String?  // foto 3x4 disimpan sebagai data URL base64
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, IMPORTED
  catatan       String?  // catatan admin saat approve/reject
  importedMahasiswaId String? // ID Mahasiswa jika sudah diimpor
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ FORM PENDAFTARAN DINAMIS ============
// Admin menyusun field-field form melalui form builder.
// Satu form bisa di-publish (isDefault=true) untuk ditampilkan di link publik.

model FormPendaftaran {
  id          String   @id @default(cuid())
  nama        String   // nama form, mis. "Pendaftaran KKN 2026"
  deskripsi   String?  // deskripsi yang ditampilkan ke mahasiswa
  isPublished Boolean  @default(false) // apakah form aktif
  isDefault   Boolean  @default(false) // form yang ditampilkan di link publik (hanya satu boleh true)
  fields      String   // JSON array berisi definisi field
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  responses   PendaftaranResponse[]
}

model PendaftaranResponse {
  id                  String   @id @default(cuid())
  formId              String
  form                FormPendaftaran @relation(fields: [formId], references: [id], onDelete: Cascade)
  data                String   // JSON berisi jawaban { [fieldKey]: value }
  status              String   @default("PENDING") // PENDING, APPROVED, REJECTED, IMPORTED
  catatan             String?  // catatan admin
  importedMahasiswaId String?  // ID Mahasiswa jika sudah diimpor
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============ LINK PENTING ============
// Kumpulan tautan eksternal untuk admin (SISTER, SIAKAD, e-learning, dll).
// Dikelola oleh admin, ditampilkan dalam card grid berdasarkan kategori.

model LinkPenting {
  id        String   @id @default(cuid())
  judul     String
  url       String
  deskripsi String?
  kategori  String   @default("Umum") // Akademik, Kepegawaian, Umum, dll
  icon      String?  // nama emoji atau lucide icon (opsional)
  urutan    Int      @default(0) // untuk sorting manual
  status    String   @default("AKTIF") // AKTIF, NONAKTIF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
